# ───────────────────────────────────────────────────────────────
# CallIt environment template. Copy to .env and fill in.
# All on-chain IDs default to the verified Sui testnet deployment
# of DeepBook Predict (branch predict-testnet-4-16); override only
# if the protocol redeploys.
# ───────────────────────────────────────────────────────────────

# Sui network
SUI_NETWORK=testnet
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# DeepBook Predict (testnet, verified 2026-06-10)
PREDICT_PACKAGE_ID=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138
PREDICT_OBJECT_ID=0xc8736204d12f0a7277c86388a68bf8a194b0a14c5538ad13f22cbd8e2a38028a
PREDICT_INDEXER_URL=https://predict-server.testnet.mystenlabs.com
DUSDC_COIN_TYPE=0xe95040085976bfd54a1a07225cd46c8a2b4e8e2b6732f140a0fc49850ba73e1a::dusdc::DUSDC

# CLI / dev wallet. If unset, the CLI generates a keypair and stores it
# in .wallets/dev.key (gitignored). Format: suiprivkey1... (bech32)
# PRIVATE_KEY=

# Operations wallet that funds new-user airdrops (100 dUSDC each).
# Leave empty to run the airdrop service in mock mode.
# OPS_WALLET_KEY=

# Postgres (social layer: users / picks / streaks / leaderboard / badges)
DATABASE_URL=postgres://callit:callit@localhost:5432/callit

# Telegram notify bot (settlement DMs + share cards; no trading)
# TELEGRAM_BOT_TOKEN=

# Enoki (zkLogin + sponsored transactions). Leave empty to use the
# dev fallback auth provider (local ephemeral keypair).
# ENOKI_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
